<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark theme (app est full dark) -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#6366f1</item>
        <item name="colorPrimaryDark">#09090e</item>
        <item name="colorAccent">#a855f7</item>
        <item name="android:windowBackground">#09090e</item>
        <item name="android:statusBarColor">#09090e</item>
        <item name="android:navigationBarColor">#09090e</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#09090e</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>